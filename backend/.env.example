# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/cogniwrite

# Security & CORS
# Comma-separated list of allowed client origins
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=replace_with_a_secure_jwt_secret_in_production
JWT_EXPIRES_IN=7d

# AI Service Configuration
# Supported providers: "mock" (default, no API key required for local dev), "openai", "gemini"
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
